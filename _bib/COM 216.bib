@article{fabianmuniesaResponsibleInnovationFinance2013,
  title = {Responsible innovation in finance: directions and implications},
  author = {{Fabián Muniesa} and {Fabian Muniesa} and {Marc Lenglet} and {Marc Lenglet} and {Marc Lenglet}},
  year = 2013,
  doi = {10.1002/9781118551424.ch10},
