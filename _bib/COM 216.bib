  year = 2014,
  journal = {Journal of Responsible Innovation},
  doi = {10.1080/23299460.2014.922249},
  abstract = {In March 2014 a group of early career researchers and academics from Sao Paulo state and from the UK met at the University of Campinas to participate in a workshop on ‘Responsible Innovation and the Governance of Socially Controversial Technologies’. In this Perspective we describe key reflections and observations from the workshop discussions, paying particular attention to the discourse of responsible innovation from a cross-cultural perspective. We describe a number of important tensions, paradoxes and opportunities that emerged over the three days of the workshop.},
