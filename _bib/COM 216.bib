@article{salaverriaDigitalJournalism252019,
  title = {Digital journalism: 25 years of research. Review article},
  shorttitle = {Digital journalism},
  author = {Salaverría, Ramón},
  year = 2019,
  month = jan,
  journal = {El Profesional de la Información},
  volume = {28},
