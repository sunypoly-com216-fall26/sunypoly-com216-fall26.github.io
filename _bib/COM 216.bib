  author = {Bisconti, Piercosma and Orsitto, Davide and Fedorczyk, Federica and Brau, Fabio and Capasso, Marianna and De Marinis, Lorenzo and Eken, Hüseyin and Merenda, Federica and Forti, Mirko and Pacini, Marco and Schettini, Claudia},
