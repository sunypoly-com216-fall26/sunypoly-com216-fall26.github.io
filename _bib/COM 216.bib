@article{sherryr.arnsteinTechnologyAssessmentOpportunities1977,
  title = {Technology assessment: Opportunities and obstacles},
  author = {{Sherry R. Arnstein} and {Sherry R. Arnstein}},
  year = 1977,
  doi = {10.1109/tsmc.1977.4309782},
  abstract = {Technology assessment (TA) is a relatively new concept with a heterogeneous "community" of practitioners and advocates. Consequently, there is much confusion about the new analytic strategy. Many people, for example, confuse TA with other technology studies such as engineering feasibility, market research, clinical trials, cost-benefit, environmental impact, technology forecasting, or technology transfer. This article-which draws most of its examples from the field of health-attempts to allay the confusion by showing how TA differs significantly from other technology studies and by articulating both the opportunities and obstacles involved in conducting comprehensive assessments. Using a question and answer format, the paper focuses on six facets of TA: 1) What is technology assessment? 2) Why is technology assessment needed? 3) How do comprehensive TA's differ from other technology studies? 4) What are the differences among evolving TA prototypes? 5) What comprehensive TA's have been done in health/medicine? 6) What are the limitations of the state of the art of TA?},
  keywords = {ring-1,sts188}
}

@article{skarbezRevisitingMilgramKishinos2021,
  title = {Revisiting milgram and kishino's reality-virtuality continuum},
  author = {Skarbez, Richard and Smith, Missie and Whitton, Mary C.},
  year = 2021,
  month = mar,
  journal = {Frontiers in Virtual Reality},
  volume = {2},
  pages = {647997},
  issn = {2673-4192},
  doi = {10.3389/frvir.2021.647997},
  url = {https://www.frontiersin.org/articles/10.3389/frvir.2021.647997/full},
  urldate = {2025-01-07},
  abstract = {This article delves into the intricate convergence of digital technologies, emphasizing the emergence of the Metaverse as a symptom of this technological unification. The discussion centres on how the Metaverse, while not a new concept, represents a significant paradigm shift in digital experience and application, a complex ecosystem consisting of interconnected virtual worlds that enable socialization, work, and creation beyond mere entertainment. It further explores Extended Reality (XR) technologies as a cornerstone of this paradigm, highlighting their role in extending physical reality through digital enhancement. The article also addresses the ethical challenges and the need for responsible innovation as XR technologies become more integrated into daily life, shaping human experience, and collecting massive sensitive data. By acknowledging the historical human drive to imagine and create virtual worlds, the chapter positions current digital advancements as iterations of these biological processes, now extended through technology like VR. Ultimately, the chapter calls for a balance between harnessing technological opportunities and exercising caution, advocating for governance and responsibility in the rapidly evolving digital landscape.},
  langid = {english},
  keywords = {ring-1,sts188}
}

@book{southwellMisinformationMassAudiences2018,
  title = {Misinformation and mass audiences},
  author = {Southwell, Brian G. and Thorson, Emily A. and Sheble, Laura},
  year = 2018,
  series = {Information},
  edition = {First edition.},
  publisher = {University of Texas Press},
  address = {Austin, Texas},
  doi = {10.7560/314555},
  abstract = {Lies and inaccurate information are as old as humanity, but never before have they been so easy to spread. Each moment of every day, the Internet and broadcast media purvey misinformation, either deliberately or accidentally, to a mass audience on subjects ranging from politics to consumer goods to science and medicine, among many others. Because misinformation now has the potential to affect behavior on a massive scale, it is urgently important to understand how it works and what can be done to mitigate its harmful effects. Misinformation and Mass Audiences brings together evidence and ideas from communication research, public health, psychology, political science, environmental studies, and information science to investigate what constitutes misinformation, how it spreads, and how best to counter it. The expert contributors cover such topics as whether and to what extent audiences consciously notice misinformation, the possibilities for audience deception, the ethics of satire in journalism and public affairs programming, the diffusion of rumors, the role of Internet search behavior, and the evolving efforts to counteract misinformation, such as fact-checking programs. The first comprehensive social science volume exploring the prevalence and consequences of, and remedies for, misinformation as a mass communication phenomenon, this will be a crucial resource for students and faculty researching misinformation, policymakers grappling with questions of regulation and prevention, and anyone concerned about this troubling, yet perhaps unavoidable, dimension of current media systems.},
  isbn = {978-1-4773-1458-6},
  langid = {english},
  keywords = {Audiences,Common fallacies,Communication,Deceptive advertising,Electronic books.,Mass media,Social aspects}
}

