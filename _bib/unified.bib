  keywords = {19th century,Academic disciplines,Allusion,Bibliographic literature,Books,Case studies,Children,Children & youth,Childrens literature,Chloe,Context,Fairy tale,Fairy tales,Folklore,Folklore studies,Genre,History,Ideology,Intertextuality,Literary devices,Literary influences,Morality,Narrative techniques,Pantomime,Participatory culture,Readers,Source materials,Storytelling,Victorian period,Writers}
