  author = {Salaverría, Ramón},
  year = 2019,
  month = jan,
  journal = {El Profesional de la Información},
  volume = {28},
  number = {1},
  issn = {1699-2407, 1386-6710},
  doi = {10.3145/epi.2019.ene.01},
  url = {https://revista.profesionaldelainformacion.com/index.php/EPI/article/view/epi.2019.ene.01},
  urldate = {2024-10-23},
  abstract = {In 1994, the first web online media outlets were introduced in several countries around the world. Twenty-five years later, digital or online journalism is a confirmed reality and common practice in professional and academic circles. Based on an extensive bibliographic review, this article examines the main areas of academic research related to digital media at the global level in the last quarter of a century. It shows the lines of research on the history of journalism on the Internet, the forms of digital media, their languages and economic challenges. It also reviews the most widespread research theories and methods. The analysis confirms that research on digital journalism is a strong, ongoing discipline, despite the fact that several methodological and thematic challenges will need to be addressed in the next few years.},
  langid = {english},
  keywords = {Julia}
}

@article{sanchezgonzalesProductionDistributionMedia2023,
  title = {Production and distribution of media news on Telegram.},
  author = {Sánchez Gonzales, Hada M. and Martos Moreno, Javier},
  year = 2023,
  month = jan,
  journal = {Communication \& Society},
  volume = {36},
  number = {1},
  pages = {95--112},
  publisher = {Ediciones Universidad de Navarra, SA},
  issn = {2386-7876},
  doi = {10.15581/003.36.1.95-112},
  url = {https://research.ebsco.com/linkprocessor/plink?id=2554be51-3ca9-3520-af69-b31bb4a4cdfe},
  urldate = {2024-11-05},
  abstract = {Against the backdrop of the new attention economy (Giraldo-Luque \&amp; Fernández Rovira, 2020), which is based on attracting audience interest, this research analyses the production and distribution of media content through the emerging Telegram platform. Attracting the attention of the audience has become the main objective of the media in the digital environment. To achieve this aim, more personalised content is now being produced, and attempts are being made to reach the user in a more direct and personal way through instant messaging platforms, especially Telegram. Through a methodology based on data triangulation, documentary analysis, interviews, registration techniques, analysis sheets, as well as direct and indirect observation (Fernández-Ballesteros, 2004), this study addresses the rise of Telegram in journalism, in addition to the way in which the Spanish media distribute, produce, and use the information, as well as interaction with the audience. To this end, a strategic sample has been used, the results of which are applicable to the media analysed. The results of this research show that nearly half of the media analysed produce content and inform the user without considering interaction, while others try to approach the user with language that is informal and friendly, or through multimedia content such as videos, emoticons, and others. The media have suddenly appeared on Telegram in search of new market niches where they can produce content for new users, thereby pursuing the rationale of the attention economy.},
  langid = {english},
  keywords = {DIGITAL technology,DOCUMENTARY television programs,EMOTICONS & emojis,INSTANT messaging,Julia,MARKET segmentation,TRIANGULATION}
}

@article{sanfordStagingFairyLandFolklore2020a,
  title = {Staging FairyLand: Folklore, Children's Entertainment, and Nineteenth-Century Pantomime by Jennifer Schacker (review)},
  shorttitle = {Staging FairyLand},
  author = {Sanford, Heather},
  year = 2020,
  journal = {Children's Literature},
  volume = {48},
  number = {1},
  pages = {275--280},
  publisher = {Johns Hopkins University Press},
  address = {Baltimore},
  issn = {0092-8208},
  doi = {10.1353/chl.2020.0011},
  abstract = {Schacker also hints at a connection between this history and costuming practices in contemporary participatory culture, although her focus tends to be on Western childhood practices such as trick-or-treat costuming and makes no mention of other costuming practices in modern Western adolescent or adult participatory culture such as cosplay. The first case study presented, focusing on Cinderella adaptations, seems to carry the most weight given its connection to previous discussions of Cinderella in the first chapter and how Schacker explicitly grounds the historical context with its significance regarding fairy-tale studies and adaptation theory. The second case study, in context of the first, feels unnecessary and redundant; although it could potentially be useful for scholars specifically pursuing bibliographical research on the Daniel O'Rourke tale, it offers little toward the argument at hand. Romantic constructions of childhood that permeated this time period had a strong influence on critical folklore discourse, with a primary goal of folklorists being to identify and preserve "purity" in fairy tales; this frequently translated to a strong disdain for adaptations and merchandising as they were seen to dilute or distort the "purity" of the "original" text (112-17). [...]as Schacker points out, the continued commercial success of fairy-tale pantomimes is somewhat of a conundrum (123).},
